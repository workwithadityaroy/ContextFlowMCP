# ContextFlow MCP — copy to .env (git-ignored) and fill in. Never commit real values.

# App role: read/write on governance tables
ConnectionStrings__ContextFlowDb=Host=localhost;Port=5432;Database=contextflow;Username=contextflow_app;Password=CHANGE_ME
# SELECT-only role for business tables queried by tools
ConnectionStrings__ToolsReadOnlyDb=Host=localhost;Port=5432;Database=contextflow;Username=contextflow_ro;Password=CHANGE_ME
ConnectionStrings__Redis=localhost:6379

# PAT signing (>= 256-bit random key)
Jwt__SigningKey=CHANGE_ME_MIN_32_BYTES
Jwt__Issuer=contextflow
Jwt__Audience=contextflow-gateway

# Docker Compose Postgres bootstrap
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=contextflow

# Audit retention window (days)
Audit__RetentionDays=30

# Dashboard (web/)
CONTEXTFLOW_API_URL=http://localhost:5000

# Exchange-rate tool (base URL is operator-controlled; host must be allowlisted for the SSRF guard)
ExchangeRate__BaseUrl=https://api.frankfurter.dev/v1/latest
ExchangeRate__AllowedHosts__0=api.frankfurter.dev
ExchangeRate__TimeoutSeconds=10

